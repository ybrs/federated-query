{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/install-hooks.sh\"",
            "statusMessage": "install git hooks (semantic comment gate)"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r \".tool_input.command\" | grep -q \"git commit\" && { export PATH=\"$HOME/.cargo/bin:$PATH\"; cd /workspace/federated-query && cargo fmt --all; } || true",
            "statusMessage": "cargo fmt before commit"
          }
        ]
      },
      {
        "matcher": "mcp__taskq__set_task_status|mcp__taskq__create_task|mcp__taskq__update_task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/done_gate.py\"",
            "timeout": 900,
            "statusMessage": "done-gate: make lint + cargo test --workspace"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/posttooluse_lint.py\""
          }
        ]
      }
    ]
  }
}
