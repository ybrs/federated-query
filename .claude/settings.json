{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/install-hooks.sh\"",
            "statusMessage": "install git hooks (semantic comment gate)"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__taskq__set_task_status|mcp__taskq__create_task|mcp__taskq__update_task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/done_gate.py\"",
            "timeout": 5400,
            "statusMessage": "done-gate: full gate unless this exact tree is already verified green"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/posttooluse_lint.py\""
          }
        ]
      }
    ]
  }
}
