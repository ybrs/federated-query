# fedq-py build artifact symlink used by the benchmark runners
benchmarks/**/fedq.so
.duckdb-lib
benchmarks/perf_compare/results/
benchmarks/perf_compare/fedq.so
.claude/worktrees/
fuzz/artifacts/
event-analytics/fedq.events/
event-analytics/fedq.mv/
event-analytics/fedq.stats.sqlite*
event-analytics/*.events/

# The materialized event store of the repo-root config; runtime state, never tracked.
event-analytics/

# Per-machine agent settings: names this container's interpreter and PATH, which
# is exactly the kind of absolute path the harnesses no longer hardcode.
.claude/settings.local.json

# Holds the taskq hub address and its shared token; a credential, never tracked.
tq.conf

# Vendored working copies of sibling repos (the frozen fedqrs engine and its
# benchmark data), carrying their own .git and build trees - tens of GB of
# artifacts that belong to those repos, not this one.
vendor/

# The datasources the e2e suite reads, created by build_test_harness.sh. It is
# generated data, rebuilt in seconds from the corpus, and large.
.test-harness/

# Output of run_isolated_tests.sh: one JSON line per variation.
isolated-results*.jsonl

# Per-process harness clones made by run_isolated_tests.sh.
.test-harness-workers/
run_all_tests.log
.test-harness-parallel/
run-e2e-logs/

# The call-graph index and its log are build products of a run over a checkout.
.fq-index/
